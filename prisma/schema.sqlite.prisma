datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/sqlite-client"
}

enum Role {
  SUPERADMIN
  TENANT_ADMIN
  TENANT_OPERATOR
}

enum BatchStatus {
  OPEN_FOR_ORDERS        // Abierto recibiendo carritos de clientes
  PURCHASED_AT_ORIGIN    // Lote comprado por el negocio en Shein/proveedor
  IN_TRANSIT             // Consolidado viajando al país destino
  RECEIVED_IN_WAREHOUSE  // Lote físico en almacén para desglose y cotejo
  COMPLETED              // Todos los clientes del lote entregados y liquidados
}

enum OrderStatus {
  DRAFT                    // Presupuesto / En armado de carrito / En toma de medidas
  CONFIRMED_DEPOSIT_PAID   // 50% / Seña abonada y comprobante adjunto
  PURCHASED_AT_ORIGIN      // Pedido comprado en proveedor / origen
  IN_TRANSIT               // Viajando al país de destino
  RECEIVED_IN_WAREHOUSE    // En almacén listo para cotejo
  MEASUREMENTS_TAKEN       // Medidas tomadas / Patronaje y corte
  IN_PRODUCTION            // En confección / Costura activa
  READY_FOR_FITTING        // Lista para prueba (Fitting)
  FINAL_ADJUSTMENTS        // En ajustes finales
  READY_FOR_DELIVERY       // Validado y listo para entregar / retirar
  COMPLETED                // 100% pagado y entregado
  CANCELLED
}

enum PaymentMethod {
  BINANCE_USDT
  BANCOLOMBIA
  NEQUI
  CASH_USD
  PAGO_MOVIL_VES
  ZINLI
  OTHER
}

model Tenant {
  id                String       @id @default(uuid())
  slug              String       @unique // ej: "ekita-shop"
  name              String
  currency          String       @default("USD")
  defaultDepositPct Decimal      @default(50.00)
  active            Boolean      @default(true)
  settings          Json?        // Métodos de pago activos, datos bancarios, tasa de cambio
  users             User[]
  customers         Customer[]
  batches           OrderBatch[]
  orders            Order[]
  orderItems        OrderItem[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model User {
  id           String   @id @default(uuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(TENANT_OPERATOR)
  createdAt    DateTime @default(now())

  @@index([tenantId])
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String   // Número de WhatsApp principal
  documentId String? // Cédula de identidad / DNI
  instagram String?
  notes     String?
  orders    Order[]
  createdAt DateTime @default(now())

  @@index([tenantId, phone])
}

model OrderBatch {
  id           String      @id @default(uuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code         String      // ej: "PEDIDO-01", "PEDIDO-02"
  name         String      // ej: "Pedido Consolidado #1"
  purchaseDate DateTime    // Fecha de compra por el negocio / fecha de salida del lote
  status       BatchStatus @default(OPEN_FOR_ORDERS)
  trackingRef  String?     // Guía macro o referencia de compra en Shein
  notes        String?
  orders       Order[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([tenantId, purchaseDate])
  @@index([tenantId, status])
}

model Order {
  id                  String         @id @default(uuid())
  tenantId            String
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batchId             String?
  batch               OrderBatch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  customerId          String
  customer            Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status              OrderStatus    @default(DRAFT)
  currency            String         @default("USD") // Moneda del pedido: "COP" | "USD" | "VES"
  orderDate           DateTime       @default(now())

  // Balances financieros (en la moneda del pedido: currency)
  subtotal            Decimal        @default(0.00)
  depositRequired     Decimal        @default(0.00) // 50% automático
  depositPaid         Boolean        @default(false)
  depositAmountPaid   Decimal        @default(0.00)
  balanceDue          Decimal        @default(0.00) // 50% restante
  finalPaymentPaid    Boolean        @default(false)

  // Registro de pago inicial (Seña 50%)
  paymentMethod       PaymentMethod?
  paymentReference    String?
  receiptImageUrl     String?        // URL del comprobante de transferencia o pago móvil

  // Registro de liquidación final (Restante 50%)
  finalPaymentMethod  PaymentMethod?
  finalPaymentRef     String?
  finalReceiptUrl     String?

  generalNotes        String?

  // Modo de negocio y soporte para costura / sastrería / confección personalizada
  businessType          String?        @default("IMPORT") // "IMPORT" | "TAILORING" | "HYBRID"
  fittingDate           DateTime?      // Fecha programada para prueba de la prenda (Fitting)
  estimatedDeliveryDate DateTime?      // Fecha estimada / pactada de entrega
  measurements          Json?          // Medidas corporales (busto, cintura, cadera, talle, etc.)
  statusHistory         Json?          // Bitácora pública de avances [{ id, status, label, note, createdAt, authorName }]

  items               OrderItem[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([tenantId, batchId])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
}

model OrderItem {
  id                   String   @id @default(uuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId              String
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Datos del producto (en la moneda del pedido)
  title                String
  originalPrice        Decimal? // Precio tachado / rayado
  finalPrice           Decimal  // Precio de página / venta
  quantity             Int      @default(1)

  // Especificaciones críticas para cotejo físico o confección
  size                 String?  // Talla (XS, S, M, L, XL, o "A Medida")
  color                String?  // Color específico
  modelVariant         String?  // Código de modelo o variación
  verificationNotes    String?  // Observaciones al validar cuando llega el paquete

  // Campos específicos para confección y costura
  serviceType          String?  // Confección a Medida, Arreglo / Ajuste, Diseño Exclusivo
  fabricDetails        String?  // Tela provista por cliente o taller, color de hilo, forro
  measurements         Json?    // Medidas específicas para esta prenda en particular

  sourceImageUrl       String?  // Captura enviada por el cliente
  isPhysicallyVerified Boolean  @default(false) // Check de validación física al recibir
  createdAt            DateTime @default(now())

  @@index([tenantId, orderId])
}

