PORT=3002

# Conexión PostgreSQL (Vercel Postgres / Neon / Supabase / Prisma Postgres)
# En Vercel, el proyecto toma automáticamente POSTGRES_PRISMA_URL, DATABASE_URL o POSTGRES_URL.
# Para desarrollo local conectado a tu instancia de Vercel, pega aquí tu cadena postgresql://...
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ordervision?schema=public"
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""

# Motor de Visión Multimodal Google Gemini API (gemini-2.5-flash)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Configuración de Almacenamiento de Archivos (S3 / Supabase / Cloudinary / Local)
STORAGE_PROVIDER="local"
STORAGE_BUCKET="ekita-orders-media"
STORAGE_PUBLIC_URL="https://storage.ekitamarket.com"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT=""
STORAGE_REGION="us-east-1"
