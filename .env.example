PORT=3002

# =========================================================================
# CONFIGURACIÓN DE BASE DE DATOS (DUAL: SQLite Local / PostgreSQL Vercel)
# -------------------------------------------------------------------------
# 1) Desarrollo Local (SQLite):
#    Deja DATABASE_URL="file:./dev.db" y vacías las variables POSTGRES_*.
#    Al ejecutar `npm run dev`, se genera el cliente SQLite (prisma/schema.sqlite.prisma)
#    y se crea automáticamente `prisma/dev.db` (ignorado en Git).
#
# 2) Producción en Vercel (PostgreSQL):
#    El repositorio mantiene `prisma/schema.prisma` configurado para PostgreSQL.
#    Al conectar la base de datos en Vercel, la plataforma inyecta automáticamente
#    POSTGRES_PRISMA_URL / DATABASE_URL / POSTGRES_URL.
# =========================================================================
DATABASE_URL="file:./dev.db"
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""

# Motor de Visión Multimodal Google Gemini API (gemini-2.5-flash)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Configuración de Almacenamiento de Archivos (S3 / Supabase / Cloudinary / Local)
STORAGE_PROVIDER="local"
STORAGE_BUCKET="ekita-orders-media"
STORAGE_PUBLIC_URL="https://storage.ekitamarket.com"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT=""
STORAGE_REGION="us-east-1"
